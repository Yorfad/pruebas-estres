{
  "name": "carga-estres-api",
  "version": "1.0.0",
  "description": "API de prueba con endpoints de operacion costosa para pruebas de carga y estres con JMeter",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "carga": "node scripts/load-test.js --escenario carga --url https://pruebas-estres-production.up.railway.app",
    "estres": "node scripts/load-test.js --escenario estres --url https://pruebas-estres-production.up.railway.app",
    "estabilidad": "node scripts/load-test.js --escenario estabilidad --url https://pruebas-estres-production.up.railway.app",
    "escaneo:hash": "node scripts/load-test.js --path /hash --steps 50,200,500,1000 --url https://pruebas-estres-production.up.railway.app",
    "escaneo:factorial": "node scripts/load-test.js --path /factorial --steps 50,200,500,1000 --url https://pruebas-estres-production.up.railway.app",
    "escaneo:procesar-json": "node scripts/load-test.js --path /procesar-json --steps 50,200,500,1000 --url https://pruebas-estres-production.up.railway.app"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
